# 服务监听端口
AICR_PORT=8080
# 数据目录（引导文件 aicr.json + SQLite 文件 + clone 缓存 + 工作目录）
AICR_DATA_DIR=/data

# --- 数据库（可选，用于无向导的「无头」首次启动；留空则首次访问走 Web 引导向导）---
# sqlite | postgres | mysql。留空：首次启动进入 Web 引导，在页面里选数据库。
AICR_DB_DRIVER=
# sqlite 留空则用 $AICR_DATA_DIR/aicr.db；外部数据库填连接串，例如：
# postgres://aicr:password@postgres:5432/aicr?sslmode=disable
# aicr:password@tcp(mysql:3306)/aicr?parseTime=true&loc=Local
# （MySQL 的 parseTime/multiStatements/charset 由后端自动补齐，可只写 user:pass@tcp(host:port)/dbname）
AICR_DB_DSN=

# 无头首次启动初始化的管理员密码与对外地址（走 Web 向导时在页面里填写）
AICR_ADMIN_PASSWORD=admin123
# 公开报告对外访问的基础地址（通知卡片里的链接用）
AICR_BASE_URL=http://localhost:8080
# JWT 签名密钥，留空则启动时随机生成
AICR_JWT_SECRET=
# worker 并发数（SQLite 写串行，建议 1-2；PostgreSQL/MySQL 可适当调高）
AICR_WORKER_CONCURRENCY=2
# 日志级别: debug | info | warn | error
AICR_LOG_LEVEL=info
# Pi Agent 可执行命令（worker 以子进程调用）
AICR_PI_AGENT_BIN=pi-agent

# 审查范围/时长护栏（可选；优先用后台「设置 → 审查范围」里的配置，环境变量仅作初始兜底）
# 只审距离最后一次提交最近 N 天的提交（默认 5）
AICR_REVIEW_WINDOW_DAYS=5
# 窗口内改动文件超过该数时只审最近改动的一批（默认 40）
AICR_REVIEW_MAX_FILES=40
# 单次审查墙钟硬超时秒数（默认 600 ≈ 10 分钟）
AICR_REVIEW_TIMEOUT_SEC=600
